<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="HouseCounter">
        <t t-if="order and (get_house_won() != 0 or get_house_spent() != 0)">
            <div class='house-balance'>
                <div class='house-balance-title'>
                    HOUSE
                </div>
                <div class='house-balance-current'>
                    <span class='value'> $  <t t-esc='get_house_current()' /></span>
                </div>
                <t t-if='get_house_won() > 0'>
                    <div class="house-balance-won">
                        Purchased
                        <span class='value'> $ +<t t-esc='get_house_won()'/></span>
                    </div>
                </t>
                <t t-if='get_house_spent() > 0'>
                    <div class="house-balance-spent">
                        Allocated
                        <span class='value'> $ -<t t-esc='get_house_spent()'/></span>
                    </div>
                </t>
                <div class='house-balance-total'>
                    Remaining
                    <span class='value'>  $  <t t-esc='get_house_total()' /></span>
                </div>
            </div>
        </t>
        <t t-elif="get_house_current() != 0">
            <div class='house-balance'>
                <div class='house-balance-title'>
                    HOUSE
                </div>
                <div class='house-balance-current'>
                    <span class='value'> $  <t t-esc='get_house_current()' /></span>
                </div>
            </div>
        </t>
        <t t-else="">
            <div></div>
        </t>
    </t>

 </templates>
