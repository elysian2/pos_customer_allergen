<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

     <t t-name="OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]//div[hasclass('before-footer')]" position="inside">
            <t t-if='props.data.house'>
                <div class='house'>
                    <span class="pos-receipt-center-align">
                        <div>--------------------------------</div>
                        <br/>
                        <div t-esc='props.data.house.name' class="pos-receipt-title"/>
                        <br />
                        <div><t t-esc='props.data.house.client' /></div>
                        <br/>
                    </span>
                    <t t-if='props.data.house.house_won'>
                        <div>Balance increase: <span t-esc='props.data.house.house_won' class="pos-receipt-right-align"/></div>
                    </t>
                    <t t-if='props.data.house.house_spent'>
                        <div>Balance used: <span t-esc='props.data.house.house_spent' class="pos-receipt-right-align"/></div>
                    </t>
                    <t t-if='props.data.house.house_total'>
                        <div>Remaining Balance: <span t-esc='props.data.house.house_total' class="pos-receipt-right-align"/></div>
                    </t>
                    <br />
                    <span class="pos-receipt-center-align">
                        <div>--------------------------------</div>
                        <br/>
                        <div t-esc='props.data.prize.prize_name' class="pos-receipt-title"/>
                        <br/>
                    </span>
                    <t t-if='props.data.prize.prize_spent'>
                        <div>Balance used: <span t-esc='props.data.prize.prize_spent' class="pos-receipt-right-align"/></div>
                    </t>
                    <t t-if='props.data.prize.prize_total'>
                        <div>Remaining Balance: <span t-esc='props.data.prize.prize_total' class="pos-receipt-right-align"/></div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

 </templates>
