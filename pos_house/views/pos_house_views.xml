    <record id="miclub_account_form_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="pos_house.action_miclub_account"/>
        <field name="multi" eval="False"/>
        <field name="sequence">1</field>
        <field name="view_id" ref="pos_house.view_miclub_account_form"/>
        <field name="view_mode">form</field>
    </record>

    <menuitem
            parent="account.menu_finance_receivables"
            action="action_miclub_account"
            id="menu_miclub_accounts"
            sequence="999"
            groups="account.group_account_user" />

</odoo>
