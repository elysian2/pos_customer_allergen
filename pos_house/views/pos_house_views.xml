            <field name='partner'/>
            <field name='account_name'/>
            <field name='balance'/>
          </tree>
        </field>
<!--        <field name="field_parent" eval="False"/>-->
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="model">member.account</field>
        <field name="name">Default tree view for ir.model(846,)</field>
        <field name="priority">16</field>
        <field name="type">tree</field>
      </record>

      <record id="view_miclub_account_form" model="ir.ui.view">
        <field name="name">miclub.account.form</field>
        <field name="model">member.account</field>
        <field name="type">form</field>
<!--        <field name="field_parent" eval="False"/>-->
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Miclub account" create="0">
