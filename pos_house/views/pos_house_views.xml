<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_pos_pos_form" model="ir.ui.view">
            <field name="name">pos.order.form.inherit</field>
            <field name="model">pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='extra']" position="inside">
                    <group name="house" string="House Balance">
                        <field name="house_balance" />
                        <field name="prize_balance" />
                        <field name="cash_balance"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_pos_order_line" model="ir.ui.view">
            <field name="name">pos.order.line.tree.inherit</field>
            <field name="model">pos.order.line</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_line"/>
            <field name="arch" type="xml">
                <data>
                    <field name="currency_id" position="after">
                        <field name="house_balance" />
                        <field name="prize_balance" />
                        <field name="cash_balance"/>
                    </field>
                </data>
            </field>
        </record>

        <record id="view_pos_order_line_form" model="ir.ui.view">
            <field name="name">pos.order.line.form.inherit</field>
            <field name="model">pos.order.line</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_order_line_form"/>
            <field name="arch" type="xml">
                <field name="currency_id" position="after">
                    <field name="house_balance" />
                    <field name="prize_balance" />
                    <field name="cash_balance"/>
                </field>
            </field>
        </record>

        <record id="view_house_program_form" model="ir.ui.view">
            <field name="name">house.account.form</field>
            <field name="model">house.accounts</field>
            <field name="arch" type="xml">
                <form string="House Accounts">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="'active' == True"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name" string="House Account Name"/>
                            <h1><field name="name"/></h1>
                        </div>

                        <div>
                            <label for="balance" string="Balance increment"/>
                            <field name="balance"/>
                        </div>

                        <notebook>
                            <page id="balance_ids" string="Balance Usage">
                                <p>Customers house balance usage</p>
                                <field name="balance_ids" colspan="4" nolabel="1">
                                    <tree string="Balance">
                                        <field name="name"/>
                                        <field name="reduction_type"/>
                                        <field name="balance_reduction" />
                                    </tree>
                                </field>
                            </page>

                            <page id="rules_ids" string="House Balance Rules">
                                <p>Rules change how House balance is topped up with specific products or categories</p>

                                <field name="rule_ids" colspan="4" nolabel="1">
                                    <tree string="Rules">
                                        <field name="name" />
                                        <field name="house_quantity"/>
                                        <field name="house_currency"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_house_program_search" model="ir.ui.view">
            <field name="name">house.accounts.search</field>
            <field name="model">house.accounts</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter string="Archived" name="active" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="view_house_rule_form" model="ir.ui.view">
            <field name="name">house.rule.form</field>
            <field name="model">house.rule</field>
            <field name="arch" type="xml">
                <form string="House Balance Usage Rule">
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Rule Name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group col="2">
                        <group col='2'>
                            <field name="rule_domain" string="Based on Products" widget="domain" options="{'model': 'product.product', 'in_dialog': true}"/>
                        </group>
                        <group col='2'>
                            <field name="house_quantity"/>
                            <field name="house_currency"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_house_reward_form" model="ir.ui.view">
            <field name="name">house.reward.form</field>
            <field name="model">house.reward</field>
            <field name="arch" type="xml">
                <form string="House Balance Usage">
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="House Usage Name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="balance_reduction" invisible="'reduction_type' == 'resale'"/>
                        <field name="minimum_house" />
                    </group>
                    <group>
                        <group>
                            <field name="reduction_type" string="Reduction" widget="radio"/>
                            <field name="discount_product_id" string="House Balance Product" invisible="'reduction_type' == 'discount'" required="'reduction_type' == 'discount'" domain="[('available_in_pos', '=', True)]" context="{'default_available_in_pos': '1'}"/>
                        </group>
                        <group>
                            <field name="gift_product_id" invisible="'reduction_type' == 'gift'" required="'reduction_type' == 'gift'" domain="[('available_in_pos', '=', True)]" context="{'default_available_in_pos': '1'}" placeholder="Select reward product"/>
                            <label string="Apply Discount" for="discount_type" invisible="'reduction_type' in ('gift')"/>
                            <div class="o_row" invisible = "'reduction_type' != 'discount'">
                                <field name="discount_type" required="'reduction_type' == 'discount'"/>
                                <field name="discount_percentage" invisible="'discount_type' == 'percentage'" required="'discount_type' == 'percentage'" class="oe_inline"/>
                                <span invisible="discount_type != 'percentage'" required="discount_type == 'percentage'" class="oe_inline">%</span>
                            </div>
<!--                            <label string="Fixed Amount" for="discount_fixed_amount" attrs="{'invisible': ['|',('discount_type', '!=', 'fixed_amount'), ('reduction_type', '!=', 'discount')]}" />-->
<!--                            <div attrs="{'invisible': ['|',('discount_type', '!=', 'fixed_amount'), ('reduction_type', '!=', 'discount')]}">-->
<!--                                <field name="discount_fixed_amount" class="oe_inline" attrs="{'required':[('discount_type', '=', 'fixed_amount')]}"/>-->
<!--                            </div>-->
<!--                            <label string="Minimum Amount" for="minimum_amount" attrs="{'invisible': ['|',('discount_type', '!=', 'fixed_amount'), ('reduction_type', '!=', 'discount')]}" />-->
<!--                            <div attrs="{'invisible': ['|',('discount_type', '!=', 'fixed_amount'), ('reduction_type', '!=', 'discount')]}">-->
<!--                                <field name="minimum_amount" class="oe_inline" attrs="{'required':[('discount_type', '=', 'fixed_amount')]}"/>-->
<!--                            </div>-->

<!--                            <field name="discount_apply_on" attrs="{'invisible':-->
<!--                            ['|', ('reduction_type', 'in', ('product', 'gift')), ('discount_type', '!=', 'percentage')]}" widget="radio"/>-->
<!--                            <field name="discount_specific_product_ids" widget='many2many_tags' attrs="{'invisible': ['|', '|', ('discount_apply_on', '!=', 'specific_products'),('discount_type', '!=', 'percentage'), ('reduction_type', 'in', ('product', 'gift'))], 'required': [('reduction_type', '=', 'discount'),('discount_apply_on', '=', 'specific_products'),('discount_type', '=', 'percentage')]}" placeholder="Select products"/>-->
<!--                            <label for="discount_max_amount" string="Max Discount Amount" attrs="{'invisible': ['|', ('reduction_type', 'in', ('product', 'gift')), ('discount_type', '!=', 'percentage')]}"/>-->
<!--                            <div attrs="{'invisible': ['|', ('reduction_type', 'in', ('product', 'gift')), ('discount_type', '!=', 'percentage')]}">-->
<!--                                <field name="discount_max_amount" class="oe_inline"/>-->
<!--                                <span class="oe_grey">if 0, no limit</span>-->
<!--                            </div>-->
                        </group>

                    </group>
                </form>
            </field>
        </record>

        <record id="view_house_program_tree" model="ir.ui.view">
            <field name="name">house.accounts.form</field>
            <field name="model">house.accounts</field>
            <field name="arch" type="xml">
                <tree string="House Accounts">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="view_house_program_kanban" model="ir.ui.view">
            <field name="name">house.accounts.kanban</field>
            <field name="model">house.accounts</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="balance"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="mb4">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="mb4" t-if="record.house.raw_value">
                                    <strong>House Balance:</strong>
                                    <span class="badge badge-pill float-right"><field name="balance"/></span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_house_program_form" model="ir.actions.act_window">
            <field name="name">House Accounts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">house.accounts</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new House Account setup
                </p><p>
                    House Accounts allows you customer to top up their 
                    balance when doing business at your shops.
                </p>
            </field>
        </record>

        <menuitem
            parent="point_of_sale.pos_config_menu_catalog"
            action="action_house_program_form"
            id="menu_house_program"
            sequence="40"
            groups="point_of_sale.group_pos_manager" />

        <record id="view_miclub_account_type" model="ir.ui.view">
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
          <tree string="MiClub account type">
            <header>
            </header>
            <field name='account_type'/>
            <field name='account_name'/>
            <field name='house'/>
            <field name='prize'/>
          </tree>
        </field>
<!--        <field name="field_parent" eval="False"/>-->
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="model">account.type</field>
        <field name="name">Default tree view for ir.model(846,)</field>
        <field name="priority">16</field>
        <field name="type">tree</field>
      </record>

      <record id="view_miclub_account_type_form" model="ir.ui.view">
        <field name="name">miclub.account.type.form</field>
        <field name="model">account.type</field>
        <field name="type">form</field>
<!--        <field name="field_parent" eval="False"/>-->
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Miclub account type" create="0">
                <sheet>
                    <group col="4" colspan="4">
                        <field name='account_type'/>
                        <field name='account_name'/>
                        <field name='house'/>
                        <field name='prize'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

      <record id="action_miclub_account_type" model="ir.actions.act_window">
        <field name="name">MiClub account types</field>
        <field name="res_model">account.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="view_id" ref="view_miclub_account_type_form" />
    </record>
    <record id="miclub_account_type_tree_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="pos_house.action_miclub_account_type"/>
        <field name="multi" eval="False"/>
        <field name="sequence" eval="False"/>
        <field name="view_id" eval="False"/>
        <field name="view_mode">tree</field>
    </record>
    <record id="miclub_account_type_form_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="pos_house.action_miclub_account_type"/>
        <field name="multi" eval="False"/>
        <field name="sequence">1</field>
        <field name="view_id" ref="pos_house.view_miclub_account_type_form"/>
        <field name="view_mode">form</field>
    </record>

    <menuitem
            parent="point_of_sale.menu_point_config_product"
            action="action_miclub_account_type"
