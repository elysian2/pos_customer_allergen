<templates xml:space="preserve">
    <t t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'order-summary')]" position="inside">
            <t t-if="props.order?.get_partner()?.pos_allergen_note">
                <div class="pos-order-allergen-warning">
                    ⚠ Customer Allergen:
                    <t t-esc="props.order.get_partner().pos_allergen_note"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
