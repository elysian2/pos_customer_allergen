<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[@class='info']" position="after">
            <t t-if="props.line.hasAllergenConflict">
                <div class="pos-allergen-warning">
                    ⚠️ ALLERGEN CONFLICT
                </div>
            </t>
        </xpath>
    </t>

</templates>
