<odoo>
    <record id='res_config_settings_view_form_pos_allergen' model='ir.ui.view'>
        <field name='name'>res.config.settings.view.form.pos.allergen</field>
        <field name='model'>res.config.settings</field>
        <field name='inherit_id' ref='point_of_sale.res_config_settings_view_form'/>
        <field name='arch' type='xml'>
            <xpath expr="//app[@name='point_of_sale']" position='inside'>
                <setting string='Customer Allergens'>
                    <field name='pos_show_customer_allergens'/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>