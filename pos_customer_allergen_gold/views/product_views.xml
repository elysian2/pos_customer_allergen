<odoo>
    <record id='product_pos_allergen' model='ir.ui.view'>
        <field name='name'>product.pos.allergen</field>
        <field name='model'>product.template</field>
        <field name='inherit_id' ref='product.product_template_form_view'/>
        <field name='arch' type='xml'>
            <xpath expr='//sheet/notebook' position='inside'>
                <page string='POS Allergens'>
                    <field name='pos_allergen_tags'/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>